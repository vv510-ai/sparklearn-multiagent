# ===================== SparkLearn 多智能体系统环境变量 =====================
# 使用方式:
# 1. 复制本文件为 .env:  cp .env.example .env
# 2. 只把真实密钥填进 .env,不要把 .env 提交到 Git。
# 3. 留空密钥时,DEMO_MODE=auto 会自动进入离线演示模式(MockEngine)。

# ---- 用户登录与会话安全 ----
# 来源:自行生成至少 32 字节随机字符串，例如:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# 真实部署:必填，并在 Render 后端环境中安全保存；不得提交到 Git。
# 用途:FastAPI 签发和校验登录 JWT。变更后所有现有登录会话会失效。
AUTH_SECRET=

# true=真实模式必须登录；demo 模式仍允许 demo_user 离线演示。
# 正式部署必须保持 true。
AUTH_REQUIRED=true

# 登录有效期（分钟），默认 7 天。生产环境可按需缩短。
AUTH_TOKEN_MINUTES=10080

# ---- 统一文本大模型（密钥只放服务端环境变量，禁止写入前端或提交真实值）----
# 当前主脑可选 deepseek；auto 会优先使用已配置的 DeepSeek，再使用星火。
LLM_PROVIDER=auto
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high

# ---- 讯飞星火文本大模型(OpenAI 兼容 HTTP,普通档与 X2/reasoner 共用)----
# 来源: 讯飞开放平台控制台 -> 星火认知大模型/HTTP 服务 -> APIPassword。
# 真实模式: 必填。demo 模式: 可留空;留空且 DEMO_MODE=auto 时会走 MockEngine。
# 用途: 作为 Authorization: Bearer <APIPassword> 调用 llm_complete()/llm_stream()。
SPARK_API_PASSWORD=

# 来源: 讯飞星火 HTTP 调用文档给出的 OpenAI 兼容 base_url。
# 真实模式: 一般保留默认值。demo 模式: 可保留默认值。
# 用途: ultra/max/pro/lite 等普通文本模型的 base_url。
SPARK_BASE_URL=https://spark-api-open.xf-yun.com/v1/

# 来源: 讯飞星火 X 系列/深度推理接口文档或控制台给出的 X2 base_url。
# 真实模式: reasoner/grounding/path 推理需要;一般保留默认值。demo 模式: 可保留默认值。
# 用途: role="reasoner" 时调用 spark-x。
SPARK_X2_BASE_URL=https://spark-api-open.xf-yun.com/x2/
SPARK_REASONING_MODE=auto

# ---- 讯飞 WebSocket/HTTP 旧鉴权三元组(TTS / 文生图 / OCR)----
# 来源: 讯飞开放平台控制台 -> 对应 WebAPI 应用 -> APPID。
# 真实模式: OCR/TTS/文生图任一真实调用必填。demo 模式: 可留空,对应功能会返回演示结果或安全降级。
SPARK_APPID=

# 来源: 讯飞开放平台控制台 -> 对应 WebAPI 应用 -> APIKey。
# 真实模式: OCR/TTS/文生图任一真实调用必填。demo 模式: 可留空。
# 注意: 这是三元组 APIKey,不是文本大模型的 APIPassword。
SPARK_API_KEY=

# 来源: 讯飞开放平台控制台 -> 对应 WebAPI 应用 -> APISecret。
# 真实模式: OCR/TTS/文生图任一真实调用必填。demo 模式: 可留空。
# 注意: 与 SPARK_API_KEY 配套用于 HMAC 签名。
SPARK_API_SECRET=

# 来源: 讯飞图片理解 API 的模型版本。general=基础版,imagev3=高级版。
# 真实模式: OCR/讲义图片理解启用时使用;demo 模式: 不调用真实服务。
SPARK_IMAGE_DOMAIN=general

# ---- 讯飞超拟人语音合成（优先于上面的普通在线 TTS）----
# 来源:讯飞开放平台控制台 -> 超拟人语音合成 -> 鉴权信息 -> APIPassword。
# 真实模式:可选；填写后互动讲解与视频旁白优先使用超拟人音色，失败时回退普通 TTS。
SPARK_SUPER_TTS_API_PASSWORD=

# 也可改用该服务页面显示的独立三元组鉴权；使用 APIPassword 时可留空。
SPARK_SUPER_TTS_APPID=
SPARK_SUPER_TTS_API_KEY=
SPARK_SUPER_TTS_API_SECRET=

# 官方超拟人语音合成 WebSocket 地址，一般保留默认值。
SPARK_SUPER_TTS_URL=wss://cbm01.cn-huabei-1.xf-yun.com/v1/private/mcd9m97e6

# 必须是在控制台已授权的发音人参数；默认使用玲小璇 Pro 女声。
SPARK_SUPER_TTS_VOICE=x6_lingxiaoxuan_pro

# ---- 讯飞中英识别大模型（语音提问转文字）----
# 来源:讯飞开放平台控制台 -> 中英识别大模型 -> WebSocket 服务接口认证信息。
# 这组三元组可与其他讯飞服务不同，不要误用文本模型 APIPassword。
SPARK_ASR_APPID=
SPARK_ASR_API_KEY=
SPARK_ASR_API_SECRET=
SPARK_ASR_URL=wss://iat.xf-yun.com/v1

# ---- 讯飞星火智能 PPT（新版；只在用户明确要求复习 PPT 时调用）----
# 可与图片理解/语音识别使用同一 WebAPI 应用。留空时会回退使用 SPARK_APPID 与
# SPARK_API_SECRET；若 PPT 服务属于独立应用，请单独填写这两项。
SPARK_PPT_APPID=
SPARK_PPT_API_SECRET=
SPARK_PPT_BASE_URL=https://zwapi.xfyun.cn

# ---- 小云雀图片 / 视频生成（可选）----
# 来源:登录 https://xyq.jianying.com -> 顶部 CLI/API -> API -> 新建 Access Key。
# 只填进本地/服务器 .env，绝不能提交真实密钥。
# “一图看懂”优先使用该通用 Nest Agent 生图，失败时保留内置清晰结构图；
# 视频失败时继续自动降级为 Manim+TTS 本地方案。
XYQ_ACCESS_KEY=

# 小云雀 OpenAPI 地址，一般保持默认值。
XYQ_BASE_URL=https://xyq.jianying.com

# 标准会员可用的低成本视频模型；VIP 可按账号权限更换。
XYQ_VIDEO_MODEL=Seedance_2.0_mini_lite

# 学习资源页默认横屏；至少 10 秒，避免概念动画短到来不及理解。
XYQ_VIDEO_RATIO=16:9
XYQ_VIDEO_DURATION=10
XYQ_VIDEO_RESOLUTION=720p

# ---- 多模态能力开关(单项关闭不影响文本大模型与主链路)----
# 来源: 本项目配置项。true=启用该能力,false=立即安全降级。
# 真实/demo 模式: 均可使用;现场若某服务抖动,只关闭对应一项即可。
MM_OCR_ENABLED=true
# 本地 OCR 兜底:讯飞图片理解未开通/超时时自动使用 RapidOCR,无需密钥。
MM_LOCAL_OCR_ENABLED=true
MM_ASR_ENABLED=true
MM_TTS_ENABLED=true
# 0—100；42 比默认语速稍慢，适合零基础讲解。
SPARK_TTS_SPEED=42
# 文生图仅使用讯飞图片生成；“一图看懂”可显式优先使用小云雀。
MM_IMAGE_ENABLED=true
# true=“一图看懂”优先使用小云雀通用 Nest Agent 生图。
MM_XYQ_IMAGE_ENABLED=true
MM_VIDEO_ENABLED=true
MM_PPT_ENABLED=true

# OCR 图片/扫描页数上限;Phase 1 图片资料入库会使用,当前先统一配置口径。
MM_OCR_MAX_PAGES=6

# ---- 多模态调用预算(秒)----
# 来源: 本项目配置项。超时只降级当前能力,不会拖垮答疑或资源生成主链路。
MM_OCR_TUTOR_TIMEOUT_S=20
MM_OCR_INGEST_TIMEOUT_S=30
MM_LOCAL_OCR_TIMEOUT_S=20
MM_ASR_TIMEOUT_S=75
MM_TTS_TIMEOUT_S=60
MM_IMAGE_TIMEOUT_S=30
# 小云雀生图为异步任务：等待预算包含多次轮询，不影响失败后的内置结构图降级。
MM_XYQ_IMAGE_WAIT_BUDGET_S=150
MM_XYQ_IMAGE_POLL_INTERVAL_S=2
# 图片产物必须经 HTTPS、体积与 PNG/JPEG/WebP 文件签名校验后才会持久化。
MM_IMAGE_DOWNLOAD_TIMEOUT_S=60
MM_IMAGE_MAX_MB=32
MM_VIDEO_CREATE_TIMEOUT_S=15
MM_VIDEO_WAIT_BUDGET_S=45
MM_VIDEO_POLL_TIMEOUT_S=15
# 小云雀任务成功后，后端会把 MP4 转存到 SparkLearn 持久化生成目录。
MM_VIDEO_DOWNLOAD_TIMEOUT_S=90
MM_VIDEO_MAX_MB=256
MM_PPT_CREATE_TIMEOUT_S=75
MM_PPT_POLL_TIMEOUT_S=15
MM_PPT_DOWNLOAD_TIMEOUT_S=45

# ---- 存储(全部可缺省:本地 SQLite + 内存向量库即可跑通 demo)----
# 来源: 自建 PostgreSQL 或 docker-compose 中的 postgres 服务连接串。
# 真实/容器模式: 建议填写 PostgreSQL。demo/本地模式: 可留空,自动使用 SQLite。
DATABASE_URL=

# 来源: Milvus 服务连接地址,例如 docker compose --profile vector 启动后的服务地址。
# 真实向量库模式: 可填。demo 模式: 可留空,自动使用内存/JSON 向量库。
MILVUS_URI=

# 来源: Redis 服务连接地址,例如 docker-compose 中的 redis。
# 真实/容器模式: 可填。demo 模式: 当前主链路可留空。
REDIS_URL=

# S3-compatible durable storage (Cloudflare R2, AWS S3, MinIO, or Supabase S3 API).
# Leave blank for local development. Production uploads otherwise disappear
# when an ephemeral Render instance is rebuilt.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=auto

# ---- Embedding / Reranker ----
# 来源: 本项目配置项。可选值: auto | bge-m3 | iflytek | hash。
# 真实模式: 如需指定真实/本地向量化后端可改。demo 模式: 建议 auto。
EMBEDDING_BACKEND=auto
IFLYTEK_EMBEDDING_URL=https://emb-cn-huabei-1.xf-yun.com/
EMBEDDING_TIMEOUT_S=12
RERANK_MODE=auto

# 来源: 可选重排服务的 HTTP 地址。
# 真实模式: 接入重排服务时填写。留空时使用本地混合重排，不再直接沿用向量顺序。
RERANK_API_URL=

# 来源: 可选重排服务的 API Key。
# 真实模式: 接入需要鉴权的重排服务时填写。demo 模式: 可留空。
RERANK_API_KEY=

# 来源: 本项目配置项。
# 真实/demo 模式: 可保留默认值;表示重排取前多少条候选。
RERANK_TOP_K=5

# ---- 行为开关 ----
# 来源: 本项目配置项。可选值: auto | true | false。
# auto: SPARK_API_PASSWORD 为空则 demo,非空则真实。
# true: 强制 demo,即使填了 SPARK_API_PASSWORD 也走 MockEngine。
# false: 强制真实,即使没填 SPARK_API_PASSWORD 也会尝试真实调用并可能失败。
DEMO_MODE=auto

# 来源: 本项目配置项。
# 真实/demo 模式: 建议 true;会写 backend/runs/{session_id} 调试包。
TRACE_ENABLED=true

# 来源: 本项目配置项。
# 本地后端端口;真实/demo 模式均可保留默认值。
BACKEND_PORT=8000

# 来源: 本项目配置项。
# 后端 CORS 允许的前端地址;本地开发默认 http://localhost:3000。
FRONTEND_ORIGIN=http://localhost:3000

# 来源: 前端运行时配置。
# 本地开发填 http://localhost:8000;docker 内部可由 compose 覆盖为 http://backend:8000。
# Next.js BFF 在服务端访问后端的地址。Docker 内由 compose 自动设为 http://backend:8000。
BACKEND_URL=http://localhost:8000
