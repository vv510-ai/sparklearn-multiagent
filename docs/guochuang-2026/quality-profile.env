# Apply each capability only after quota, model access and server connectivity pass.
# Keep existing secrets, database, auth and storage settings.
LLM_PROVIDER=openai
IMAGE_PROVIDER=openai
VISION_PROVIDER=openai
ASR_PROVIDER=openai
TTS_PROVIDER=openai
PPT_PROVIDER=native
# Ark access is separate from OpenAI quota; enable Seedance 2.5 in the Ark account first.
VIDEO_PROVIDER=ark
OPENAI_TEXT_MODEL=gpt-6-astra
OPENAI_VISION_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=high
OPENAI_TIMEOUT_S=180
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=high
OPENAI_ASR_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
ARK_VIDEO_MODEL=doubao-seedance-2-5-260628
ARK_VIDEO_DURATION=10
ARK_VIDEO_RESOLUTION=720p
