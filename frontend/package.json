{
  "name": "sparklearn-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:e2e": "next dev -p 13000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "prebuild": "node scripts/copy-pdf-worker.mjs && node scripts/verify-word-audio.mjs",
    "predev": "node scripts/copy-pdf-worker.mjs"
  },
  "dependencies": {
    "driver.js": "1.8.0",
    "fflate": "0.8.3",
    "katex": "0.16.47",
    "lucide-react": "^0.468.0",
    "next": "16.2.12",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "9.0.1",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.0",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.4.19",
    "postcss": "8.5.25",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
